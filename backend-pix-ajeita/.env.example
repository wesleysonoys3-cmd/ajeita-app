# ================================================================
# AjeitaAí Backend Pix — Variáveis de Ambiente OBRIGATÓRIAS / OPCIONAIS
# 
# Este é um arquivo EXEMPLO. Copie para `.env` e preencha os valores.
# O .env real NUNCA deve ser commitado (já está protegido no .gitignore).
# ================================================================

# ---------------------------------------------------------------
# 1. FIREBASE ADMIN (para ler/escrever Firestore) — obrigatório
# ---------------------------------------------------------------
# Cole TODO o JSON bruto do Service Account (baixado no console Firebase
# > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
FIREBASE_SERVICE_ACCOUNT_JSON={}

# ---------------------------------------------------------------
# 2. MERCADO PAGO (Pix + recarga de moedas + patrocínios)
# ---------------------------------------------------------------
# Produção real usa prefixo "APP_USR-..." (NÃO use modo MOCK!).
# Homologação/teste: use "TEST-..."
MERCADO_PAGO_ACCESS_TOKEN=
# Opcional (recomendado produzão): assinatura HMAC do webhook MP.
MERCADO_PAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# 3. BACKEND PÚBLICO + PORTA (Render / localhost)
# ---------------------------------------------------------------
BACKEND_PUBLIC_URL=https://ajeita-backend-pix.onrender.com
PORT=7001

# ---------------------------------------------------------------
# 4. INFRA E-MAIL SMTP (NOVO 2026-09-24) — OBRIGATÓRIO para 2FA admin docs
# ---------------------------------------------------------------
# Exemplos:
#   Gmail SMTP (via senha de app)      : smtp.gmail.com        porta 587 (STARTTLS)
#   Zoho:                               smtp.zoho.com          porta 465 (TLS)
#   Outlook/Office365:                  smtp.office365.com     porta 587
#   SendGrid:                           smtp.sendgrid.net      porta 587
#   Resend/SMTP custom:                 smtp.resend.com        porta 465
SMTP_HOST=
# Normalmente 587 (STARTTLS seguro, mais comum) OU 465 (TLS direto).
SMTP_PORT=
SMTP_USER=
# IMPORTANTE: senha / chave SMTP NUNCA deve ser commitada.
# Use senha de aplicativo em provedores com 2FA na conta (ex: Gmail).
SMTP_PASSWORD=
# Ex: "AjeitaAí Serviços Domésticos <no-reply@ajeitaai.com.br>"
EMAIL_FROM=
# Opcional: "true" para porta 465 TLS. Se omitido, detecta via SMTP_PORT=465.
SMTP_SECURE=

# ---------------------------------------------------------------
# 5. 2FA ADMIN — Documentos de Validação (NOVO 2026-09-24)
# ---------------------------------------------------------------
# E-mail do(a) administrador(a) que RECEBERÁ o código de 6 dígitos
# ao solicitar acesso aos documentos de validação de profissionais.
# Padrão se omitido: ti.mello.santos@gmail.com
SMTP_ADMIN_2FA_TO=ti.mello.santos@gmail.com
