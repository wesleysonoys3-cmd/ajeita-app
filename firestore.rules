rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admin)
        && request.auth.uid in get(/databases/$(database)/documents/config/admin).data.adminUids;
    }

    function ehDono(uidDoc) {
      return request.auth != null && request.auth.uid == uidDoc;
    }

    match /profissionais/{uidDoc} {
      allow read:  if true;
      allow write: if isAdmin()
                   || ehDono(uidDoc)
                   || request.resource.data.uid == uidDoc;
    }

    match /clientes/{uidDoc} {
      allow read:   if isAdmin() || ehDono(uidDoc);
      allow write:  if isAdmin()
                    || (ehDono(uidDoc)
                        && (!('uid' in request.resource.data)
                            || request.resource.data.uid == uidDoc));
    }

    match /solicitacoes/{id} {
      allow read, update: if isAdmin()
                          || (request.auth != null && (
                               request.auth.uid == resource.data.clienteId
                               || request.auth.uid == resource.data.profissionalId));
      allow create: if isAdmin()
                    || (request.auth != null
                        && request.auth.uid == request.resource.data.clienteId);
    }

    match /avaliacoes/{id} {
      allow read:    if true;
      allow create:  if isAdmin()
                     || (request.auth != null
                         && request.auth.uid == request.resource.data.clienteId);
    }

    match /config/admin {
      allow read:  if true;
      allow write: if isAdmin()
                   || !exists(/databases/$(database)/documents/config/admin);
    }

    match /pix_transacoes/{externalRef} {
      allow read, create:  if true;
      allow update:        if isAdmin()
                           || (request.auth != null && request.auth.uid == resource.data.uid_usuario);
    }

    match /pix_solicitacoes_manuais/{id} {
      allow read:   if isAdmin()
                    || (request.auth != null && request.auth.uid == resource.data.profissionalId);
      allow create: if isAdmin() || request.auth != null;
      allow update: if isAdmin();
    }

    match /recargas/{id} {
      allow read, create: if isAdmin()
                          || (request.auth != null && request.auth.uid == resource.data.profissional_id);
    }
  }
}
